# --- Variable ---
ARG CPULIMIT="0,1"
ARG MEMLIMIT="2048M"
ARG DISKLIMIT="32G"

ARG  PG_VERSION="16"
ARG  PG_PORT="5432"

# --- Limit resource ---
LIMITS cpu ${CPULIMIT}
LIMITS memoryuse ${MEMLIMIT}
LIMITS datasize 20G ${DISKLIMIT}

# --- Config ---
CONFIG set allow.sysvipc 1
RESTART

# install required templates
#INCLUDE https://github.com/bastille-templates/exmaples

# install required packages
PKG postgresql${PG_VERSION}-server postgresql${PG_VERSION}-client

# Create POSTGRESQL DATADIR
CMD mkdir -p /var/db/postgres/data${PG_VERSION}

# enable and start postgre
SYSRC postgresql_enable=YES
SYSRC postgresql_data="/var/db/postgres/data${PG_VERSION}"

SERVICE postgresql initdb

# copy files
CP var / /var/db/postgres/data${PG_VERSION}

# 
CMD chown -R postgres:postgres /var/db/postgres/data${PG_VERSION}
RENDER /var/db/postgres/data${PG_VERSION}/postgresql.conf
RENDER /var/db/postgres/data${PG_VERSION}/pg_hba.conf

SERVICE postgresql start

#RDR tcp ${PG_PORT} 5432

TAGS database postgresql pg${PG_VERSION}